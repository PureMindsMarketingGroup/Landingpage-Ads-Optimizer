# Kopieer dit bestand naar .env.local voor lokaal draaien,
# en zet dezelfde variabelen in Vercel onder Settings -> Environment Variables.

# Verplicht. Aanmaken op https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Verplicht. De instructies voor het model (de system prompt). Staat bewust niet in
# deze repo: Pure Minds bewaart hem zelf. Plak hem in Vercel als één waarde, met alle regels.
SYSTEM_PROMPT=

# Optioneel. Laat leeg of weg = de tool is open voor iedereen met de link.
# Vul je hier een wachtwoord in, dan vraagt de tool daar eenmalig om.
APP_PASSWORD=

# Optioneel. Standaard logt de function bij elke analyse de schone paginatekst die naar
# het model gaat (handig om de scraper te controleren). Zet op false om dat uit te zetten.
LOG_PAGE_TEXT=
